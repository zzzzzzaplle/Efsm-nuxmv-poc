{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/system_interface.schema.json",
  "title": "System Interface Schema",
  "description": "System interface contract defining states, events, variables, and observable output signals.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "output_events"
  ],
  "properties": {
    "states": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
      }
    },
    "initial_state": {
      "type": "string"
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
      }
    },
    "variables": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "type",
          "initial"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
          },
          "type": {
            "enum": [
              "boolean",
              "integer",
              "enum"
            ]
          },
          "values": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
            }
          },
          "initial": {
            "type": [
              "boolean",
              "integer",
              "string"
            ]
          },
          "minimum": {
            "type": "integer"
          },
          "maximum": {
            "type": "integer"
          }
        }
      }
    },
    "output_events": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
      }
    }
  }
}
