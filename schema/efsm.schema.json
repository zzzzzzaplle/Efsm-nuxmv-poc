{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/efsm.schema.json",
  "title": "Minimal EFSM Schema",
  "description": "Minimal JSON representation of an Extended Finite State Machine.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "initialState",
    "states",
    "events",
    "variables",
    "transitions",
    "properties"
  ],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
    },
    "initialState": {
      "type": "string"
    },
    "states": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9_]*$"
      }
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9_]*$"
      }
    },
    "variables": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/variable"
      }
    },
    "transitions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/transition"
      }
    },
    "properties": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/formalProperty"
      }
    }
  },
  "$defs": {
    "variable": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "type",
        "initial"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
        },
        "type": {
          "enum": [
            "boolean",
            "integer"
          ]
        },
        "initial": {
          "type": [
            "boolean",
            "integer"
          ]
        },
        "minimum": {
          "type": "integer"
        },
        "maximum": {
          "type": "integer"
        }
      }
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source",
        "event",
        "target"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^T[0-9]+$"
        },
        "source": {
          "type": "string"
        },
        "event": {
          "type": "string"
        },
        "guard": {
          "type": "string",
          "default": "TRUE"
        },
        "target": {
          "type": "string"
        },
        "actions": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "default": {}
        }
      }
    },
    "formalProperty": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "formula"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^P[0-9]+$"
        },
        "kind": {
          "const": "CTL"
        },
        "formula": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      }
    }
  }
}