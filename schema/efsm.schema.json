{
  "title": "Extended EFSM Schema (IR v2)",
  "description": "JSON representation of an Extended Finite State Machine, fused with FSM-Bench-20.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "states",
    "initial_state",
    "events",
    "transitions"
  ],
  "properties": {
    "name": {
      "type": "string"
    },
    "system_name": {
      "type": "string"
    },
    "domain": {
      "type": "string"
    },
    "initial_state": {
      "type": "string"
    },
    "states": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
      }
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
      }
    },
    "variables": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/variable"
      },
      "default": []
    },
    "transitions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/transition"
      }
    },
    "forbidden_behaviours": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/forbiddenBehaviour"
      },
      "default": []
    }
  },
  "$defs": {
    "variable": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "type",
        "initial"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
        },
        "type": {
          "enum": [
            "boolean",
            "integer",
            "enum"
          ]
        },
        "values": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
          }
        },
        "initial": {
          "type": [
            "boolean",
            "integer",
            "string"
          ]
        },
        "minimum": {
          "type": "integer"
        },
        "maximum": {
          "type": "integer"
        }
      }
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "event",
        "target"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "event": {
          "type": "string"
        },
        "guard": {
          "type": "string",
          "default": "TRUE"
        },
        "action": {
          "type": "string",
          "default": ""
        },
        "updates": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "default": {}
        },
        "outputs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "target": {
          "type": "string"
        },
        "requirement": {
          "type": "string",
          "default": ""
        }
      }
    },
    "forbiddenBehaviour": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "trace": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reason": {
          "type": "string",
          "default": ""
        },
        "requirement": {
          "type": "string",
          "default": ""
        }
      }
    }
  }
}