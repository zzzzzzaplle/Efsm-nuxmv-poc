{
  "states": [
    "Idle",
    "CreditAvailable",
    "Dispensing"
  ],
  "initial_state": "Idle",
  "events": [
    "insert_coin",
    "press_coffee",
    "press_tea",
    "cancel",
    "dispense_complete"
  ],
  "variables": [
    {
      "name": "creditStored",
      "type": "boolean",
      "initial": false
    },
    {
      "name": "selectedDrink",
      "type": "enum",
      "values": [
        "NONE",
        "COFFEE",
        "TEA"
      ],
      "initial": "NONE"
    }
  ],
  "transitions": [
    {
      "source": "Idle",
      "event": "insert_coin",
      "target": "CreditAvailable",
      "updates": {
        "creditStored": "true"
      },
      "requirement": "R2"
    },
    {
      "source": "Idle",
      "event": "press_coffee",
      "target": "Idle",
      "requirement": "R5"
    },
    {
      "source": "Idle",
      "event": "press_tea",
      "target": "Idle",
      "requirement": "R5"
    },
    {
      "source": "Idle",
      "event": "cancel",
      "target": "Idle",
      "requirement": "R8"
    },
    {
      "source": "CreditAvailable",
      "event": "insert_coin",
      "target": "CreditAvailable",
      "outputs": [
        "REJECT_COIN"
      ],
      "requirement": "R12"
    },
    {
      "source": "CreditAvailable",
      "event": "press_coffee",
      "target": "Dispensing",
      "outputs": [
        "DISPENSE_COFFEE"
      ],
      "updates": {
        "selectedDrink": "COFFEE"
      },
      "requirement": "R3"
    },
    {
      "source": "CreditAvailable",
      "event": "press_tea",
      "target": "Dispensing",
      "outputs": [
        "DISPENSE_TEA"
      ],
      "updates": {
        "selectedDrink": "TEA"
      },
      "requirement": "R4"
    },
    {
      "source": "CreditAvailable",
      "event": "cancel",
      "target": "Idle",
      "outputs": [
        "RETURN_COIN"
      ],
      "updates": {
        "creditStored": "false"
      },
      "requirement": "R7"
    },
    {
      "source": "Dispensing",
      "event": "dispense_complete",
      "target": "Idle",
      "updates": {
        "creditStored": "false",
        "selectedDrink": "NONE"
      },
      "requirement": "R6"
    },
    {
      "source": "Dispensing",
      "event": "press_coffee",
      "target": "Dispensing",
      "requirement": "R9"
    },
    {
      "source": "Dispensing",
      "event": "press_tea",
      "target": "Dispensing",
      "requirement": "R9"
    },
    {
      "source": "Dispensing",
      "event": "cancel",
      "target": "Dispensing",
      "requirement": "R13"
    }
  ]
}